{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "types": ["astro/client"]
  },
  "include": [
    "src/**/*",
    "src/design/data/.roadmap/event",
    "src/design/data/.roadmap/timeline",
    "src/design/data/.roadmap/bar-chart",
    "src/design/data/.roadmap/bento",
    "src/design/data/.roadmap/description-list",
    "src/design/data/.roadmap/key-value",
    "src/design/data/.roadmap/key-value-list",
    "src/design/data/.roadmap/pie-chart",
    "src/design/data/.roadmap/result-item",
    "src/design/data/.roadmap/sparkline"
  ]
}