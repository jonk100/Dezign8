---
import Head from "./Head.astro";
import "../design/styles/global.css";
import Header from "~/layout_/header/Header.astro";
import Footer from "~/layout_/footer/Footer.astro";
import Container from "~/layout_/container/Container.astro";
import Paper from "~/surfaces_/paper/Paper.astro";

export interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} image={image}>
      <slot name="head" />
    </Head>
  </head>
  <body>
    <Header class="header-component">
      <slot name="header" />
    </Header>
    <Container>
      <Paper class="hero--wrapper">
        <slot name="hero" />
      </Paper>
      <main>
        <Paper class="main-top--wrapper">
          <slot name="main-top" />
        </Paper>
        <Paper class="main--wrapper">
          <slot />
        </Paper>
        <Paper class="main-bottom--wrapper">
          <slot name="main-bottom" />
        </Paper>
      </main>
      <Paper class="zero--wrapper">
        <slot name="zero" />
      </Paper>
    </Container>
    <script>
      import { mountMotionScroll } from "~/shared/motion/motion.scroll";
      import { mountActions, mountCopyButtons } from "~/shared/actions/actions.global";
      mountMotionScroll();
      mountActions();
      mountCopyButtons();
    </script>
  </body>
  <Footer>
    <slot name="footer" />
  </Footer>
</html>
