---
import Layout from "../Layout.astro";
import ThemeToggle from "../../design/triggers/components/theme-toggle/ThemeToggle.astro";
import Breadcrumbs from "../../design/nav/components/breadcrumbs/Breadcrumbs.astro";
import type { BreadcrumbItemData } from "../../design/nav/components/breadcrumbs/breadcrumbs.props";
import "./docs-layout.css";
import H from "~/typography/components/heading/H.astro";
import Text from "~/typography/components/text/Text.astro";
import Link from "~/triggers/components/link/Link.astro";
import Icon from "~/assets/components/icon/Icon.astro";
import type { SvgName } from "~/shared/icons";
import Navbar from "~/nav/components/navbar/Navbar.astro";
import NavbarBrand from "~/nav/components/navbar/brand/NavbarBrand.astro";
import NavbarContent from "~/nav/components/navbar/content/NavbarContent.astro";
import Image from "~/assets/components/image/Image.astro";
import Badge from "~/feedback/components/badge/Badge.astro";
import Flex from "~/layout/components/flex/Flex.astro";
import Button from "~/triggers/components/button/Button.astro";
import Tooltip from "~/overlays/components/tooltip/Tooltip.astro";
import Inline from "~/layout/components/inline/Inline.astro";

interface Props {
  title: string;
  description?: string;
  category?: string;
  status?: string;
  version?: string;
  icon?: string;
  showTitle?: boolean;
  links?: {
    source?: string;
    figma?: string;
  };
  prev?: { title: string; href: string } | undefined;
  next?: { title: string; href: string } | undefined;
}

const { title, description, category, status, version, icon, showTitle = true, links, prev, next } = Astro.props;

const breadcrumbItems: BreadcrumbItemData[] = [{ id: "home", label: "Home", href: "/" }];

if (category) {
  const categorySlug = category.toLowerCase().replace(/\s+/g, "-");
  breadcrumbItems.push({
    id: categorySlug,
    label: category,
    href: `/docs/${categorySlug}`,
  });
}

breadcrumbItems.push({ id: "current", label: title, active: true });
---

<Layout title={`${title} | Dezign8 Docs`} description={description}>
  <Navbar slot="header">
    <NavbarBrand slot="brand">
      <Link class="logo__link" href="/">
        <Image
          src="/horizontal-blue.png"
          alt="Dezign8 Logo"
          style="height: 32px; width: auto; display: block;"
        />
      </Link>
    </NavbarBrand>
    <NavbarContent>
      <div style="display: flex; gap: 1rem; align-items: center;">
        <Link href="/docs">Docs</Link>
        <Link href="/components">Components</Link>
        <Link href="/">
          <Icon name="home" size="md" /> Home
        </Link>
        <ThemeToggle variant="ghost" color="neutral" />
      </div>
    </NavbarContent>
  </Navbar>
  <Breadcrumbs items={breadcrumbItems} size="xs" />
  <div class="docs-container">

      {showTitle && (
        <Inline class="docs-heading">
          {icon && <Icon name={icon as SvgName} size="xl" color="tertiary" />}
          <H level={1} size="h1" weight="bold" >
            {title}
          </H>
        </Inline>
      )}

      {
        (category || status || version) && (
          <div class="badges">
            {category && <span class="badge">📁 {category}</span>}
            {status && <span class={`badge status-${status}`}>{status}</span>}
            {version && <span class="badge">v{version}</span>}
          </div>
        )
      }

      {
        description && (
        <Inline my="xl">
          <Text size="lg" fontStyle="oblique" color="muted">
            {description}
          </Text>
        </Inline>
        )
      }

      {
        links && (
          <div class="links">
            {links.source && (
              <a href={links.source} target="_blank" rel="noopener noreferrer">
                ↗ View Source
              </a>
            )}
            {links.figma && (
              <a href={links.figma} target="_blank" rel="noopener noreferrer">
                🎨 Figma Reference
              </a>
            )}
          </div>
        )
      }

    <main class="docs-content">
      <slot />
    </main>

    {(prev || next) && (
      <nav class="docs-footer-nav" aria-label="Pagination">
        {prev ? (
          <a href={prev.href} class="docs-footer-link prev">
            <Icon name="arrow-left" size="sm" />
            <span class="label">Previous</span>
            <span class="title">{prev.title}</span>
          </a>
        ) : <div />}
        
        {next ? (
          <a href={next.href} class="docs-footer-link next">
            <span class="label">Next</span>
            <span class="title">{next.title}</span>
            <Icon name="arrow-right" size="sm" />
          </a>
        ) : <div />}
      </nav>
    )}
  </div>

  {prev && (
    <div class="docs-floating-nav prev">
      <Tooltip content={prev.title} placement="right">
        <Button href={prev.href} variant="ghost" iconOnly aria-label={`Previous: ${prev.title}`}>
          <Icon name="chevron-left" />
        </Button>
      </Tooltip>
    </div>
  )}

  {next && (
    <div class="docs-floating-nav next">
      <Tooltip content={next.title} placement="left">
        <Button href={next.href} variant="ghost" iconOnly aria-label={`Next: ${next.title}`}>
          <Icon name="chevron-right" />
        </Button>
      </Tooltip>
    </div>
  )}
</Layout>
