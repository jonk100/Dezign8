---
import { getCollection } from 'astro:content';
import Layout from '../layouts/docs/DocsLayout.astro';
import Prose from '~/typography/components/prose/Prose.astro';
import Table from '~/data/components/table/Table.astro';
import Image from '~/assets/components/image/Image.astro';
import Text from '~/typography/components/text/Text.astro';
import Stack from '~/layout/components/stack/Stack.astro';
import Code from '~/typography/components/code/Code.astro';
import Link from '~/triggers/components/link/Link.astro';

// Live component counts via glob — excludes .roadmap and parts/ sub-components
const allComponents   = import.meta.glob('../design/*/components/**/*.astro');
const roadmapOrParts  = (p: string) => p.includes('/.roadmap/') || p.includes('/parts/');
const componentPaths  = Object.keys(allComponents).filter(p => !roadmapOrParts(p));

const categories = ['assets','data','feedback','forms','layout','nav','overlays','surfaces','triggers','typography'] as const;

const categoryStats = categories.map(cat => ({
  name: cat,
  label: cat.charAt(0).toUpperCase() + cat.slice(1),
  components: componentPaths.filter(p => p.includes(`/design/${cat}/`)).length,
  props: Object.keys(import.meta.glob('../design/*/components/**/*.props.ts')).filter(p => p.includes(`/design/${cat}/`)).length,
}));

const totalComponents = componentPaths.length;
const allProps        = import.meta.glob('../design/**/*.props.ts');
const sharedProps     = Object.keys(allProps).filter(p => p.includes('/shared/')).length;
const totalProps      = Object.keys(allProps).length - sharedProps;

const allDocs = await getCollection('docs');

const categoriesMap = new Map<string, { categoryDoc: any, components: any[] }>();

allDocs.forEach((doc: any) => {
	const parts = doc.id.split('/');
	const name = parts[parts.length - 1].replace(/\.mdx?$/, '');
	const isCategoryDoc = parts.length >= 2 && parts[parts.length - 2] === name;

	const categoryName = doc.data.category || 'Uncategorized';
	
	if (!categoriesMap.has(categoryName)) {
		categoriesMap.set(categoryName, { categoryDoc: null, components: [] });
	}
	
	if (isCategoryDoc) {
		categoriesMap.get(categoryName)!.categoryDoc = { frontmatter: doc.data };
	} else {
		categoriesMap.get(categoryName)!.components.push(doc);
	}
});

const mdxComponents = {
  table: Table,
  img: Image,
  code: Code,
  Text,
  Stack,
};

const categorizedLists = Array.from(categoriesMap.entries()).map(([name, data]) => ({
	name,
	slug: name.toLowerCase().replace(/\s+/g, '-'),
	...data
})).sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Component Library" showTitle={false}>
	<Prose>
	<section class="container">
		<Image as="h1" v="image" src="/horizontal-blue.png" alt="Dezign8 Logo" mb="3xl" />
		<Text size="xl" color="tertiary">Interface Emitter for Smooth Browsing.</Text>

		<!-- ── TOP-LINE STATS ──────────────────────────────────── -->
		<div class="stat-hero">
			<div class="stat-hero__item stat-hero__item--primary">
				<span class="stat-hero__num">{totalComponents}</span>
				<span class="stat-hero__label">Total Components</span>
			</div>
			<div class="stat-hero__item">
				<span class="stat-hero__num">{totalProps}</span>
				<span class="stat-hero__label">Prop Interfaces</span>
			</div>
			<div class="stat-hero__item">
				<span class="stat-hero__num">{sharedProps}</span>
				<span class="stat-hero__label">Shared Base Props</span>
			</div>
			<div class="stat-hero__item">
				<span class="stat-hero__num">{categories.length}</span>
				<span class="stat-hero__label">Categories</span>
			</div>
		</div>

		<!-- ── PER-CATEGORY BREAKDOWN ─────────────────────────── -->
		<div class="stat-grid">
			{categoryStats.map(s => (
				<a href={`/docs/${s.name}`} class="stat-card">
					<span class="stat-card__num">{s.components}</span>
					<span class="stat-card__name">{s.label}</span>
					<span class="stat-card__sub">{s.props} prop file{s.props !== 1 ? 's' : ''}</span>
					<div class="stat-card__bar" style={`--fill: ${Math.round((s.components / totalComponents) * 100)}%`}></div>
				</a>
			))}
		</div>

		<div class="categories-list">
			{categorizedLists.map(cat => (
				<div class="category-group">
					<h2 class="category-title">
						<Link v="h2" href={`/docs/${cat.slug}`} class="category-link">{cat.name}</Link>
					</h2>
					{cat.categoryDoc && cat.categoryDoc.frontmatter?.description && (
						<p class="category-desc">{cat.categoryDoc.frontmatter.description}</p>
					)}
					
					<ul class="component-list">
						{cat.components.length > 0 ? cat.components.map((doc: any) => (
							<li>
								<a href={`/docs/${doc.id}`} class="component-link">↳ {doc.data.title}</a>
								<p class="desc">{doc.data.description}</p>
							</li>
						)) : (
							<li><p class="desc empty">No components documented in this category yet.</p></li>
						)}
					</ul>
				</div>
			))}
			
			{categorizedLists.length === 0 && (
				<p>No documentation entries found yet.</p>
			)}
		</div>
	</section>
	</Prose>
</Layout>
