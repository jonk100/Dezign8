	/* ── STAT HERO ─────────────────────────────────────────── */
	
	.stat-hero__item {
		background: var(--bg--1);
		border: 1px solid var(--border--subtle);
		border-radius: var(--radius--xl);
		padding: var(--space-in--md) var(--space-in--lg);
		display: flex;
		flex-direction: column;
		gap: var(--space-in--2xl);
		box-shadow: var(--shadow--lg);
	}

	.stat-hero__item--primary {
		background: var(--primary--subtle);
		border-color: var(--primary--border);
	}

	.stat-hero__num {
		font-size: clamp(2rem, 3vi, 3.2rem);
		font-weight: var(--weight--black);
		line-height: 1;
		color: var(--text--layer-1);
		letter-spacing: var(--tracking--tight);
	}

	.stat-hero__item--primary .stat-hero__num {
		color: var(--primary--text);
	}

	.stat-hero__label {
		font-size: var(--fs--xs);
		font-weight: var(--weight--semibold);
		color: var(--text--muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	/* ── STAT GRID ─────────────────────────────────────────── */

	.stat-grid {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.75rem;
		margin-bottom: 3rem;
	}

	.stat-card {
		background: var(--bg--1);
		border: 1px solid var(--border--subtle);
		border-radius: var(--radius--lg);
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		text-decoration: none;
		color: inherit;
		position: relative;
		overflow: hidden;
		transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
	}

	.stat-card:hover {
		border-color: var(--primary--border);
		box-shadow: var(--shadow--md);
		transform: translateY(-2px);
	}

	.stat-card__num {
		font-size: 1.9rem;
		font-weight: var(--weight--black);
		line-height: 1;
		color: var(--text--layer-1);
		letter-spacing: var(--tracking--tight);
	}

	.stat-card__name {
		font-size: var(--fs--xs);
		font-weight: var(--weight--semibold);
		color: var(--text--layer-2);
		margin-top: 0.25rem;
	}

	.stat-card__sub {
		font-size: var(--fs--xs);
		color: var(--text--muted);
	}

	.stat-card__bar {
		position: absolute;
		bottom: 0;
		left: 0;
		height: 3px;
		width: var(--fill, 0%);
		background: var(--primary--vivid);
		border-radius: 0 2px 0 0;
		opacity: 0.6;
		transition: opacity 0.15s;
	}

	.stat-card:hover .stat-card__bar {
		opacity: 1;
	}

	@media (max-width: 700px) {
		.stat-hero { grid-template-columns: repeat(2, 1fr); }
		.stat-grid  { grid-template-columns: repeat(2, 1fr); }
	}
</style>
