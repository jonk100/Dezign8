---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/docs/DocsLayout.astro';
import Prose from '~/typography/components/prose/Prose.astro';
import Code from '~/typography/components/code/Code.astro';
import Pre from '~/typography/components/code/Pre.astro';
import Quote from '~/typography/components/quote/Quote.astro';
import H from '~/typography/components/heading/H.astro';
import Table from '~/data/components/table/Table.astro';
import Image from '~/assets/components/image/Image.astro';
import Text from '~/typography/components/text/Text.astro';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  
  // Exclude category index pages from generating component routes
  const componentDocs = allDocs.filter((doc: any) => {
      const parts = doc.id.split('/');
      const name = parts[parts.length - 1].replace(/\.mdx?$/, '');
      return !(parts.length >= 2 && parts[parts.length - 2] === name);
  });

  return componentDocs.map((entry: any) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: any };
const { Content } = await render(entry);

const mdxComponents = {
  code: Code,
  pre: Pre,
  blockquote: Quote,
  table: Table,
  img: Image,
  p: Text,
  h1: H,
  h2: H,
  h3: H,
  h4: H,
  h5: H,
  h6: H,
};

const { title, description, category, status, version, links } = entry.data;
---

<DocsLayout 
  title={title} 
  description={description}
  category={category}
  status={status}
  version={version}
  links={links}
>
  <Prose>
    <Content components={mdxComponents} />
  </Prose>
</DocsLayout>
