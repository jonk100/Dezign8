---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  
  // Exclude category index pages from generating component routes
  const componentDocs = allDocs.filter((doc: any) => {
      const parts = doc.id.split('/');
      const name = parts[parts.length - 1].replace(/\.mdx?$/, '');
      return !(parts.length >= 2 && parts[parts.length - 2] === name);
  });

  return componentDocs.map((entry: any) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: any };
const { Content } = await render(entry);

const { title, description, category, status, version, links } = entry.data;
---

<Layout title={`${title} | Dezign8 Docs`} description={description}>
	<slot name="head">
		<style>
			.docs-container {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}
			.header {
				border-bottom: 1px solid var(--border--default, #e5e7eb);
				padding-bottom: 2rem;
				margin-bottom: 2rem;
			}
			.back-link {
				color: var(--text--secondary, #6b7280);
				text-decoration: none;
				margin-bottom: 2rem;
				display: inline-block;
			}
			.back-link:hover {
				text-decoration: underline;
			}
			.badges { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
			.badge {
				padding: 0.25rem 0.75rem;
				border-radius: var(--radius--full, 999px);
				font-size: var(--fs--xs, 0.75rem);
				font-weight: var(--weight--semibold, 600);
				text-transform: uppercase;
				letter-spacing: var(--tracking--wider, 0.05em);
				background: var(--bg--2, #f3f4f6);
				color: var(--text--secondary);
			}
			.status-draft { background: var(--warning--subtle, #fef08a); color: var(--warning--deep, #854d0e); }
			.status-experimental { background: var(--warning--muted, #fed7aa); color: var(--warning--deep, #9a3412); }
			.status-stable { background: var(--success--subtle, #bbf7d0); color: var(--success--deep, #166534); }
			.status-deprecated { background: var(--danger--subtle, #fecaca); color: var(--danger--deep, #991b1b); }
			
			.links a {
				color: var(--primary--text, #3b82f6);
				text-decoration: none;
				margin-right: 1rem;
				font-weight: var(--weight--medium, 500);
			}
			.links a:hover { text-decoration: underline; }
			
			/* Basic Markdown Element Reset for MDX content */
			:global(.docs-content pre) { 
				background: var(--bg--4, #1f2937); 
				color: var(--text--inverse, #f9fafb); 
				padding: 1.25rem; 
				border-radius: var(--radius--md, 0.5rem); 
				overflow-x: auto; 
				margin-bottom: 1.5rem;
			}
			:global(.docs-content code) { font-family: var(--family--mono, monospace); font-size: 0.9em; }
			:global(.docs-content :not(pre) > code) { 
				background: var(--bg--2, #f3f4f6); 
				padding: 0.125rem 0.25rem; 
				border-radius: var(--radius--sm, 0.25rem); 
				color: var(--danger--text, #ef4444); 
			}
			:global(.docs-content table) { width: 100%; border-collapse: collapse; margin: 2rem 0; }
			:global(.docs-content th), :global(.docs-content td) { text-align: left; padding: 0.75rem 1rem; border-bottom: 1px solid var(--border--subtle, #e5e7eb); }
			:global(.docs-content th) { background: var(--bg--1, #f9fafb); font-weight: var(--weight--semibold, 600); }
			:global(.docs-content h2) { 
				border-bottom: 1px solid var(--border--subtle, #e5e7eb); 
				padding-bottom: 0.5rem; 
				margin-top: 2.5rem; 
				margin-bottom: 1rem;
			}
			:global(.docs-content h3) { margin-top: 1.5rem; margin-bottom: 0.5rem; }
			:global(.docs-content p) { margin-bottom: 1rem; }
		</style>
	</slot>

	<div class="docs-container">
		<header class="header">
			<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem;">
				<a href="/" class="back-link" style="margin-bottom: 0;">← Back to Home</a>
				<a href="/"><img src="/dezign83.png" alt="Dezign8 Logo" style="height: 32px; width: auto; display: block;" /></a>
			</div>
			
			<div class="badges">
				{category && <span class="badge">📁 {category}</span>}
				<span class={`badge status-${status}`}>{status}</span>
				{version && <span class="badge">v{version}</span>}
			</div>

			<h1 style="font-size: var(--fs--3xl); font-weight: var(--weight--bold); margin-bottom: 0.5rem;">{title}</h1>
			<p style="font-size: var(--fs--lg); color: var(--text--secondary); margin-bottom: 1.5rem;">{description}</p>
			
			{links && (
				<div class="links">
					{links.source && <a href={links.source} target="_blank" rel="noopener noreferrer">↗ View Source</a>}
					{links.figma && <a href={links.figma} target="_blank" rel="noopener noreferrer">🎨 Figma Reference</a>}
				</div>
			)}
		</header>

		<main class="docs-content">
			<Content />
		</main>
	</div>
</Layout>
