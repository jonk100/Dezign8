---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/docs/DocsLayout.astro';
import Prose from '~/typography/components/prose/Prose.astro';
import Table from '~/data/components/table/Table.astro';
import Image from '~/assets/components/image/Image.astro';
import Text from '~/typography/components/text/Text.astro';
import Code from '~/typography/components/code/Code.astro';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  
  // A category doc is one where the filename matches the directory name, e.g., typography/typography
  const categoryDocs = allDocs.filter((doc: any) => {
      const parts = doc.id.split('/');
      const name = parts[parts.length - 1].replace(/\.mdx?$/, '');
      return parts.length >= 2 && parts[parts.length - 2] === name && doc.data.category;
  });

  categoryDocs.sort((a: any, b: any) => {
    const catA = (a.data.category || '').toLowerCase();
    const catB = (b.data.category || '').toLowerCase();
    return catA.localeCompare(catB);
  });
  
  return categoryDocs.map((catDoc: any, index: number) => {
      const categoryName = catDoc.data.category;
      const slugified = categoryName.toLowerCase().replace(/\s+/g, '-');
      const components = allDocs.filter((d: any) => 
          d.data.category === categoryName && d.id !== catDoc.id
      );

      const prevEntry = index > 0 ? categoryDocs[index - 1] : null;
      const nextEntry = index < categoryDocs.length - 1 ? categoryDocs[index + 1] : null;
      
      return {
          params: { category: slugified },
          props: { 
              categoryName, 
              components,
              docEntry: catDoc,
              prevEntry,
              nextEntry
          }
      };
  });
}

const mdxComponents = {
  table: Table,
  img: Image,
  code: Code,
  Text,
};

const { categoryName, components, docEntry, prevEntry, nextEntry } = Astro.props as { categoryName: string, components: any[], docEntry: any, prevEntry?: any, nextEntry?: any };

const { Content } = await render(docEntry);
const { title = `${categoryName} Category`, description = `Index of components in the ${categoryName} category.` } = docEntry.data;

const prev = prevEntry ? { title: prevEntry.data.title || prevEntry.data.category, href: `/docs/${prevEntry.data.category.toLowerCase().replace(/\s+/g, '-')}` } : undefined;
const next = nextEntry ? { title: nextEntry.data.title || nextEntry.data.category, href: `/docs/${nextEntry.data.category.toLowerCase().replace(/\s+/g, '-')}` } : undefined;
---

<DocsLayout title={title} description={description} prev={prev} next={next}>
  {components.length > 0 && (
    <div class="component-table-wrapper">
      <table class="component-table">
        <thead>
          <tr>
            <th>Component</th>
            <th>Props</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody>
          {components.map((component: any) => {
            const name = component.data.title.replace(' Component', '');
            const href = `/docs/${component.id}`;
            const propsString = component.data.props || '—';
            return (
              <tr onclick={`window.location.href='${href}'`} class="clickable-row">
                <td><a href={href} class="component-link"><code>&lt;{name}&gt;</code></a></td>
                <td>{propsString !== '—' ? <code>{propsString}</code> : <span class="text-muted">—</span>}</td>
                <td>{component.data.description}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}

  <Prose>
    {Content ? <Content components={mdxComponents} /> : <p>No detailed documentation provided for this category.</p>}
  </Prose>
</DocsLayout>
