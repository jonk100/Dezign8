---
import { getCollection } from 'astro:content';
import DocsLayout from '../../../layouts/docs/DocsLayout.astro';
import Prose from '~/typography/components/prose/Prose.astro';

const systemDocs = await getCollection('system');
---

<DocsLayout
  title="System Specifications"
  description="Core system tokens, architecture, motion, and color specifications."
  category="System"
>
  <Prose>
    <p>This section documents the underlying architecture, token definitions, and conventions of the design system.</p>
  </Prose>

  <ul style="list-style: none; padding: 0; margin: 2rem 0; display: flex; flex-direction: column; gap: 1.5rem;">
    {systemDocs.map((doc: any) => (
      <li style="padding-left: 1rem; border-left: 2px solid var(--border--subtle);">
        <a href={`/docs/system/${doc.id}`} style="font-size: var(--fs--md); font-weight: var(--weight--semibold); color: var(--primary--text); text-decoration: none; display: inline-block;">
          ↳ {doc.data.title}
        </a>
        <p style="margin: 0.25rem 0 0 0; color: var(--text--muted); font-size: var(--fs--sm);">
          {doc.data.description}
        </p>
      </li>
    ))}
  </ul>
</DocsLayout>
