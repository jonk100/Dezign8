---
import type { KbdProps } from "./kbd.props";
import { useKbd } from "./kbd.hook";
import Icon from "~/assets/components/icon/Icon.astro";import "./kbd.css";

const { props } = useKbd(Astro.props as KbdProps);
const { icon } = Astro.props;
---
<kbd {...props}>
  {icon && <Icon name={icon} />}
  <slot />
</kbd>
