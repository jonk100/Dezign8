{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/design/*"
      ],
      "@/*": [
        "src/*"
      ],
      "~sh/*": [
        "src/design/shared/*"
      ],
      "~st/*": [
        "src/design/styles/*"
      ],
      "~l/*": [
        "src/design/layout/*"
      ],
      "~ty/*": [
        "src/design/typography/*"
      ],
      "~tr/*": [
        "src/design/triggers/*"
      ],
      "~a/*": [
        "src/design/assets/*"
      ],
      "~f/*": [
        "src/design/forms/*"
      ],
      "~fb/*": [
        "src/design/feedback/*"
      ],
      "~su/*": [
        "src/design/surfaces/*"
      ],
      "~da/*": [
        "src/design/data/*"
      ],
      "~o/*": [
        "src/design/overlays/*"
      ],
      "~n/*": [
        "src/design/nav/*"
      ],
      "~/assets_/*": [
        "src/design/assets/components/*"
      ],
      "~/data_/*": [
        "src/design/data/components/*"
      ],
      "~/feedback_/*": [
        "src/design/feedback/components/*"
      ],
      "~/forms_/*": [
        "src/design/forms/components/*"
      ],
      "~/layout_/*": [
        "src/design/layout/components/*"
      ],
      "~/nav_/*": [
        "src/design/nav/components/*"
      ],
      "~/overlays_/*": [
        "src/design/overlays/components/*"
      ],
      "~/shared_/*": [
        "src/design/shared/components/*"
      ],
      "~/surfaces_/*": [
        "src/design/surfaces/components/*"
      ],
      "~/triggers_/*": [
        "src/design/triggers/components/*"
      ],
      "~/typography_/*": [
        "src/design/typography/components/*"
      ]
    }
  }
}